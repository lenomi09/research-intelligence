.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Testing / coverage ---
.pytest_cache/
